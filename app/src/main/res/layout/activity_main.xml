<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="👑 ARIANA VPN" android:textSize="22sp" android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="وضعیت اتصال:" android:textColor="@color/dim" />
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="قطع است"
                android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/power" android:layout_width="150dp" android:layout_height="150dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="32dp"
            android:contentDescription="اتصال / قطع" android:src="@drawable/ic_power" />

        <TextView
            android:id="@+id/tvTimer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:text="برای اتصال کلیک کنید"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⬇ دریافت" android:textColor="@color/dim" />
                <TextView android:id="@+id/tvRx" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⬆ ارسال" android:textColor="@color/dim" />
                <TextView android:id="@+id/tvTx" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="روش اتصال (هسته Aether)" android:textColor="@color/dim" />
            <RadioGroup android:id="@+id/modes" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/rbMasque" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:checked="true" android:text="MASQUE — سریع و پایدار" />
                <RadioButton android:id="@+id/rbGool" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Gool" />
                <RadioButton android:id="@+id/rbPsiphon" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Psiphon" />
                <RadioButton android:id="@+id/rbTor" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Tor" />
            </RadioGroup>
        </LinearLayout>

        <TextView android:id="@+id/tvNote" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="#FFFF4D6D" />
        <TextView android:id="@+id/tvLog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/dim" android:textSize="10sp"
            android:fontFamily="monospace" android:layoutDirection="ltr" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:gravity="center"
            android:text="طراحی و توسعه: فاطمه زهرا ساعي" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center"
            android:text="هسته: Aether (CluvexStudio) · AGPL-3.0"
            android:textColor="@color/dim" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
